{
	"name": "rajtik76/nette-console",
	"description": "Artisan-like console for Nette: Symfony Console in DI, package auto-discovery and make: generators",
	"keywords": ["nette", "console", "symfony", "discovery", "generator"],
	"type": "library",
	"license": "MIT",
	"require": {
		"php": ">=8.4",
		"contributte/console": "^0.11",
		"nette/bootstrap": "^3.2",
		"nette/di": "^3.2",
		"nette/neon": "^3.4 || ^4.0",
		"nette/utils": "^4.0"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"nette/phpstan-rules": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"Rajtik\\Console\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Rajtik\\Console\\Tests\\": "tests/"
		}
	},
	"extra": {
		"nette": {
			"extensions": {
				"console": "Contributte\\Console\\DI\\ConsoleExtension(%consoleMode%)",
				"netteConsole": "Rajtik\\Console\\DI\\NetteConsoleExtension(%consoleMode%)"
			}
		}
	},
	"scripts": {
		"type:check": "phpstan analyse",
		"tester": "tester tests -s -C",
		"ci:check": [
			"@type:check",
			"@tester"
		]
	},
	"minimum-stability": "stable",
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
